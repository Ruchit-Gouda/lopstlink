SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_secret_key

# Comma separated list of frontend origins allowed by CORS.
# Use * only for quick local experiments.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional storage settings
STORAGE_BUCKET=item-images
IMAGE_URL_TTL=86400

# Minimum similarity score (0-100) for a report to appear as a match.
MATCH_THRESHOLD=25

# Contact details are only released to the reporter of a matched report when
# the two reports score at least this much.
CONTACT_REVEAL_THRESHOLD=70

# Link credits awarded for publishing a report.
LOST_REPORT_POINTS=10
FOUND_REPORT_POINTS=15
